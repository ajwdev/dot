#!/usr/bin/env bash
set -eo pipefail

delete_empty=false
HEAD=origin/main
for arg in "$@"; do
    case "$arg" in
        --delete-empty)
            delete_empty=true
            ;;
        *)
            HEAD=$arg
            ;;
    esac
done

git fetch -p

deleted=()
failed=()
skipped=()
skipped_empty=()

worktree_branches=()
while IFS= read -r line; do
    if [[ $line == branch\ * ]]; then
        branch="${line#branch }"
        branch="${branch#refs/heads/}"
        worktree_branches+=("$branch")
    fi
done < <(git worktree list --porcelain)

branch_in_worktree() {
    local br=$1
    local wt_br
    for wt_br in "${worktree_branches[@]}"; do
        if [[ "$br" == "$wt_br" ]]; then
            return 0
        fi
    done
    return 1
}

for br in $(git for-each-ref --format='%(refname:short)' refs/heads); do
    if [[ "$br" == "main" || "$br" == "master" ]]; then
        continue
    fi

    if branch_in_worktree "$br"; then
        echo "== Skipping $br (in use by worktree)"
        skipped+=("$br")
        continue
    fi

    if [[ $(git rev-list --count "$HEAD..$br") == "0" ]]; then
        if [[ "$delete_empty" != "true" ]]; then
            echo "== Skipping $br (no commits on top of $HEAD)"
            skipped_empty+=("$br")
            continue
        fi

        echo "== Deleting $br (no commits on top of $HEAD)"
        if git branch -D "$br" 2>&1; then
            deleted+=("$br")
        else
            failed+=("$br")
        fi
        continue
    fi

    if ! cherry=$(git cherry "$HEAD" "$br"); then
        echo "== Failed to inspect $br"
        failed+=("$br")
        continue
    fi

    if [[ -n "$cherry" ]] && ! grep -q '^+' <<<"$cherry"; then
        echo "== Deleting $br (squash/cherry-picked into $HEAD)"
        if git branch -D "$br" 2>&1; then
            deleted+=("$br")
        else
            failed+=("$br")
        fi
    fi
done

echo ""
echo "Summary:"
echo "  Deleted: ${#deleted[@]} branches"
if [ ${#skipped[@]} -gt 0 ]; then
    echo "  Skipped: ${#skipped[@]} branches (in use by worktrees)"
fi
if [ ${#skipped_empty[@]} -gt 0 ]; then
    echo "  Skipped empty: ${#skipped_empty[@]} branches (use --delete-empty to delete)"
fi
if [ ${#failed[@]} -gt 0 ]; then
    echo "  Failed: ${#failed[@]} branches"
    echo ""
    echo "Failed branches (inspect/delete manually):"
    printf '    %s\n' "${failed[@]}"
fi
if [ ${#skipped[@]} -gt 0 ]; then
    echo ""
    echo "Skipped branches (checked out in worktrees):"
    printf '    %s\n' "${skipped[@]}"
fi
if [ ${#skipped_empty[@]} -gt 0 ]; then
    echo ""
    echo "Skipped empty branches (use --delete-empty to delete):"
    printf '    %s\n' "${skipped_empty[@]}"
fi
