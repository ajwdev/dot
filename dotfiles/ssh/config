Host github.com
    User git
    VisualHostKey no

Host tomservo tomservo.local tomservo.localdomain
    User andrew
    ForwardX11 yes
    ForwardX11Trusted yes

Host *
    IdentityFile ~/.ssh/id_ed25519
    IdentityFile ~/.ssh/id_rsa
    ForwardAgent yes
    TCPKeepAlive yes
    ServerAliveInterval 30
    ServerAliveCountMax 10
    VisualHostKey yes
    EnableEscapeCommandline yes
